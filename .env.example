# 브리프 제출 메일 발송 (Vercel > Project > Settings > Environment Variables 에 등록)
#
# RESEND_API_KEY 가 없으면 메일을 보내지 않고, 제출자가 워크북 파일을 직접
# 내려받아 담당자에게 보내도록 화면에서 안내합니다. 폼 자체는 그대로 동작합니다.

# 메일 전송 경로. 사내 SMTP가 실제 발송 검증되기 전에는 반드시 resend를 유지합니다.
WORKBOOK_MAIL_TRANSPORT=resend

# 사내 SMTP Relay 설정. WORKBOOK_MAIL_TRANSPORT=smtp 로 바꿀 때만 사용합니다.
# TLS/인증 정책은 IT운영팀 확인 뒤 값만 바꿔 사용합니다.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_REQUIRE_TLS=true
SMTP_SECURE=false

# 기본 발송 경로인 Resend API 키 (https://resend.com > API Keys)
RESEND_API_KEY=

# 보내는 사람. nasmedia.co.kr 도메인을 Resend 에서 인증한 뒤에만 이 주소를 쓸 수 있습니다.
WORKBOOK_MAIL_FROM=

# 받는 사람 (콤마로 여러 명). 비우면 openai@nasmedia.co.kr 로 갑니다.
WORKBOOK_MAIL_TO=openai@nasmedia.co.kr

# 참조 (선택, 콤마로 여러 명)
WORKBOOK_MAIL_CC=
